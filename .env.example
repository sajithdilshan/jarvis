# Copy to .env and fill in. Loaded by docker-compose and the app.

# ==============================================================================
# LLM Providers
# ==============================================================================

# OpenAI (if using openai: models)
OPENAI_API_KEY=

# AWS Bedrock (boto3 credential chain; used for bedrock: models)
# Set AWS_BEDROCK_ENABLED=1 to make start.sh export SSO credentials from AWS_PROFILE.
# Leave at 0 (default) when using OpenAI/Ollama — start.sh then skips all AWS auth.
AWS_BEDROCK_ENABLED=0
# NOTE: do NOT set AWS_PROFILE here. It would be forwarded into the container, which has
# no ~/.aws/config and would fail. Keep AWS_PROFILE in your host shell (e.g. ~/.zshrc);
# start.sh reads it there and exports the static creds below into the container.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1

# Ollama (local; used for ollama: models)
# Default: http://host.docker.internal:11434/v1 (Docker → host Mac)
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ==============================================================================
# Model Configuration
# ==============================================================================

# Override models without editing default.yaml:
# JARVIS_DEFAULT_MODEL=ollama:jarvis-agent
# JARVIS_INTERACTIVE_MODEL=bedrock:arn:aws:bedrock:eu-central-1:...
# JARVIS_SOURCE_AGENT_MODEL=bedrock:arn:aws:bedrock:eu-central-1:...  # cheap model for scheduled source sub-agents
# JARVIS_MODEL_OVERRIDE=                # global override, wins over all

# ==============================================================================
# MCP Server Tokens
# ==============================================================================

# GitHub Personal Access Token (scopes: repo, notifications, user)
GITHUB_TOKEN=

# Slack browser session tokens (see docs/slack-mcp-setup.md)
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=

# Gmail uses OAuth via ~/.gmail-mcp/ (see docs/gmail-mcp-setup.md), NOT an env token.

# ==============================================================================
# Schedule
# ==============================================================================

# Cron expression for the periodic poll (default: every 15 min, 8am-6pm, Mon-Fri)
# JARVIS_SCHEDULE_CRON=*/15 8-17 * * 1-5
# JARVIS_SCHEDULE_TIMEZONE=Europe/Berlin
# JARVIS_SCHEDULE_ENABLED=true

# ==============================================================================
# Infrastructure (usually set by docker-compose, not manually)
# ==============================================================================

# TEMPORAL_HOST=temporal:7233
# POSTGRES_DSN=postgresql://temporal:temporal@postgres:5432/jarvis
# JARVIS_MCP_CONFIG=/app/mcp/servers.yaml
# JARVIS_UI_STATIC_DIR=/app/web/dist
